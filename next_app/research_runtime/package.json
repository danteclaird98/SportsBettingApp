{
  "name": "vite-react-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:backend",
    "preview": "vite preview",
    "test:model": "node --experimental-test-isolation=none --test tests/correctedReceiving.test.ts tests/historicalCohort.test.ts",
    "build:backend": "esbuild backend/index.ts --bundle --platform=node --format=esm --alias:@appdeploy/sdk=./compat/sdk.ts --outfile=build/backend.mjs",
    "test:odds": "node --test tests/oddsBackend.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "esbuild": "^0.25.0"
  }
}
